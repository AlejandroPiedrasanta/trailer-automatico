#!/bin/bash
# Tráiler automático · CINEMA PRODUCTIONS
# compilar/mac/pkg/scripts/postinstall — corre al terminar de copiar la app (como root; las tareas, como el usuario que esta frente a
# la Mac): carpeta de color de DaVinci con permiso, ffmpeg (si la app no lo trae y no hay, con Homebrew), fuentes de los titulos,
# carpetas de trabajo y el color/ruido en DaVinci. Nunca falla la instalacion: lo que no se pudo, el programa lo avisa al abrirse.

APP="/Applications/TrailerAutomatico.app"
BIN="$APP/Contents/MacOS/TrailerAutomatico"
LUT="/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT/MCP"

xattr -dr com.apple.quarantine "$APP" 2>/dev/null
mkdir -p "$LUT" && chmod 777 "$LUT"                        # el programa escribe ahi la reduccion de ruido en cada armado

# carpeta compartida: musica/SFX y fuente con licencia (fuera de la app: las actualizaciones no las traen) y pedidos al servicio
COMP="/Users/Shared/TrailerAutomatico"
mkdir -p "$COMP/pedidos" "$COMP/audio" "$COMP/fuentes" && chmod 777 "$COMP" "$COMP/pedidos" "$COMP/audio" "$COMP/fuentes"
SIN_ABRIR=0; [ -f "$COMP/.sin_abrir" ] && SIN_ABRIR=1           # la instalacion la hace el servicio de actualizaciones

# servicio de actualizaciones (root, como CineCaptions): al encender, cada 4 h y cuando el programa deja un pedido
ETQ="com.cinemaproductions.trailerautomatico.actualizar"
PLIST="/Library/LaunchDaemons/$ETQ.plist"
EST="/Library/Application Support/TrailerAutomatico/actualizar"
mkdir -p "$EST"
NUEVO="$(mktemp)"
cat > "$NUEVO" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$ETQ</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>--tarea</string><string>actualizar_fondo</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>14400</integer>
  <key>QueueDirectories</key><array><string>$COMP/pedidos</string></array>
  <key>StandardOutPath</key><string>$EST/servicio.log</string>
  <key>StandardErrorPath</key><string>$EST/servicio.log</string>
</dict></plist>
PL
if ! cmp -s "$NUEVO" "$PLIST"; then                       # solo si cambio: recargarlo mataria una actualizacion en curso
    cp "$NUEVO" "$PLIST"; chown root:wheel "$PLIST"; chmod 644 "$PLIST"
    launchctl bootout "system/$ETQ" 2>/dev/null
    launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null
elif ! launchctl print "system/$ETQ" >/dev/null 2>&1; then
    launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null
fi
rm -f "$NUEVO"

USUARIO=$(stat -f%Su /dev/console 2>/dev/null)
[ -z "$USUARIO" ] || [ "$USUARIO" = "root" ] && exit 0
UID_U=$(id -u "$USUARIO")
CASA=$(dscl . -read "/Users/$USUARIO" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
[ -d "$CASA" ] || exit 0
LOG="$CASA/Library/Logs/TrailerAutomatico_instalacion.log"
mkdir -p "$CASA/Library/Logs"
echo "== $(date '+%Y-%m-%d %H:%M:%S')  Tráiler automático: tareas de instalación" >> "$LOG"

# el programa que estaba abierto se cierra (sus archivos ya se reemplazaron)
pkill -TERM -f "^$BIN\$" 2>/dev/null && sleep 3 && pkill -9 -f "^$BIN\$" 2>/dev/null

como_usuario() { launchctl asuser "$UID_U" sudo -u "$USUARIO" -H env HOME="$CASA" USER="$USUARIO" \
                 PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$@"; }

# ffmpeg: la app puede traerlo; si no, el del sistema; si tampoco, Homebrew (si esta instalado)
if [ ! -x "$APP/Contents/Frameworks/ffmpeg/ffmpeg" ] && [ ! -x "$APP/Contents/Resources/ffmpeg/ffmpeg" ]; then
    if ! [ -x /opt/homebrew/bin/ffmpeg ] && ! [ -x /usr/local/bin/ffmpeg ]; then
        BREW=""; [ -x /opt/homebrew/bin/brew ] && BREW=/opt/homebrew/bin/brew; [ -x /usr/local/bin/brew ] && BREW=/usr/local/bin/brew
        if [ -n "$BREW" ]; then
            echo "-- instalando ffmpeg con Homebrew" >> "$LOG"
            como_usuario "$BREW" install ffmpeg >> "$LOG" 2>&1
        else
            echo "-- AVISO: falta ffmpeg y no hay Homebrew (brew.sh)" >> "$LOG"
        fi
    fi
fi

ESTADO="/tmp/trailer_instalar.$$.txt"
: > "$ESTADO"; chmod 666 "$ESTADO"
como_usuario QT_QPA_PLATFORM=offscreen "$BIN" --tarea instalar "$ESTADO" >> "$LOG" 2>&1 &
P=$!
for i in $(seq 1 150); do kill -0 "$P" 2>/dev/null || break; sleep 2; done
kill -9 "$P" 2>/dev/null
grep -v '^PROGRESO' "$ESTADO" >> "$LOG" 2>/dev/null
rm -f "$ESTADO"
chown "$USUARIO" "$LOG" 2>/dev/null

if [ "$SIN_ABRIR" = 1 ]; then                              # actualizacion del servicio: el abre (o no) el programa
    rm -f "$COMP/.sin_abrir"
    echo "-- instalado por el servicio de actualizaciones" >> "$LOG"
    exit 0
fi

# Al terminar: se abre el programa y se cierra el Instalador (la persona: "cuando se termine de instalar se abre
# automaticamente y se cierra el instalador"). Va en segundo plano y espera a que el Instalador escriba el recibo del
# paquete (lo hace despues de este script), asi la instalacion queda completa antes de cerrarlo. Tambien expulsa el .dmg.
RECIBO="/var/db/receipts/com.cinemaproductions.trailerautomatico.plist"
INICIO=$(date +%s)
ORIGEN="${PACKAGE_PATH:-$1}"
VOL=""
case "$ORIGEN" in /Volumes/*) VOL="/Volumes/$(echo "${ORIGEN#/Volumes/}" | cut -d/ -f1)" ;; esac
(
    for i in $(seq 1 60); do
        [ -f "$RECIBO" ] && [ "$(stat -f %m "$RECIBO" 2>/dev/null || echo 0)" -ge "$INICIO" ] && break
        sleep 1
    done
    sleep 2
    como_usuario /usr/bin/open "$APP"
    sleep 2
    como_usuario /usr/bin/osascript -e 'tell application "Installer" to quit'
    if [ -n "$VOL" ] && [ -d "$VOL" ]; then
        sleep 2
        hdiutil detach "$VOL" -quiet 2>/dev/null || hdiutil detach "$VOL" -force -quiet 2>/dev/null
    fi
    echo "-- abierto el programa y cerrado el Instalador" >> "$LOG"
) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null
exit 0
